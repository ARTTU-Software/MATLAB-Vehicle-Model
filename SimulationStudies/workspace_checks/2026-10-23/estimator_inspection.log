        expression: "xhat = Subsystem(StateTransitionFcnInputs, y1) where StateTransitionFcnInputs=blk_4253:1355.y1, y1=blk_4253:1356.y1"
      blocks: 
        interface: 
          Inport: 
            - id: "blk_4253:1476" #u1
