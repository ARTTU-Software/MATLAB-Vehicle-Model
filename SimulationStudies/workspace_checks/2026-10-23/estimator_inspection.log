        algorithm: 
          - id: "blk_4253:1479"
            Name: Adaptive Covariance
            BlockType: MATLABFunction
            derived_info: 
              expression: |
                function R= fcn(xhat)
                
                vx_safe = max(abs(xhat(1)), 1e-3);
                
                if vx_safe < 2.0
                    R_cog = single(1e6);
                else
                    R_cog = single((0.01 / vx_safe)^2);
                end
                
                R = single(diag([1e-3, R_cog, 5e-4, 1e-4, 1e-2, 1e-2]));
