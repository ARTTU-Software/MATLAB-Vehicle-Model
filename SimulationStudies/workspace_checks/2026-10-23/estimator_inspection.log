          - id: "blk_3525:396"
            Name: MATLAB Function
            BlockType: MATLABFunction
            derived_info: 
              expression: |
                function Q = fcn(xhat)
                
                vx_safe = max(abs(xhat(1)), 1e-3);
                
                if vx_safe < 1.5
                    Q_vy = single(2e-7);
                else
                    Q_vy = single((1e-4* vx_safe)^2);
                end
                
                Q = single(diag([1e-5, Q_vy, 1e-6, 5e-5, 1e-4]));
